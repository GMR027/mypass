{
  "name": "My Pass",
  "short_name": "My Pass",
  "description": "Bóveda personal cifrada para pases, documentos y credenciales.",
  "start_url": "/vault",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f9ff",
  "theme_color": "#012d1d",
  "lang": "es-MX",
  "icons": [
    {
      "src": "/images/favicon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/favicon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": ["application/pdf", "image/*"]
        }
      ]
    }
  }
}
